# ForgeFlow Environment Configuration Template
# Copy to .env for local runtime execution

# System
ENV=development
LOG_LEVEL=info

# HTTP Server (API)
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL
DATABASE_URL=postgres://forgeflow:forgeflow_secret@localhost:5432/forgeflow?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MIN_OPEN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_HEALTH_TIMEOUT=5s

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_RETRIES=3
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_SIZE=50
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=100ms
LEASE_DURATION=30s
HEARTBEAT_INTERVAL=10s
JOB_DEFAULT_TIMEOUT=60s
JOB_MAX_RETRIES=3
RETRY_BACKOFF_INITIAL=1s
RETRY_BACKOFF_MAX=60s
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_JITTER_PERCENT=0.20

# Scheduler Configuration
SCHEDULER_POLL_INTERVAL=1s
SCHEDULER_LEASE_RECOVERY_INTERVAL=5s
SCHEDULER_WORKFLOW_CHECK_INTERVAL=2s
SCHEDULER_LEADER_LOCK_TTL=15s

# Authentication & Security
JWT_SECRET=forgeflow-insecure-dev-secret-change-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Observability
METRICS_PORT=9090
METRICS_PATH=/metrics
